{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slack-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI 绑定 —— LLM（文档定制章节：用 Workers AI 替代 OpenAI，免 API key）
  "ai": { "binding": "AI" },
  // 多租户：每个 Slack workspace（team_id）一个独立的 Agent 实例与存储
  "durable_objects": {
    "bindings": [{ "name": "MyAgent", "class_name": "MyAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MyAgent"] }]
  // ⚠️ 不要在这里声明 SLACK_* vars！vars 会占据绑定名导致 wrangler secret put
  // 报错 10053（见 env-extra.d.ts —— 用类型合并补齐字段，凭据一律走 secret）：
  //   npx wrangler secret put SLACK_CLIENT_ID
  //   npx wrangler secret put SLACK_CLIENT_SECRET
  //   npx wrangler secret put SLACK_SIGNING_SECRET
  // 本地开发用 .dev.vars（已 gitignore）。
}
